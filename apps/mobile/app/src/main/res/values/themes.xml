<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BaseHaptic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/gray_950</item>
    </style>

    <style name="LiveScoreCountRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="LiveScoreCountLabel">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/live_score_text_secondary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LiveScoreCountDot">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:background">@drawable/notification_dot_empty</item>
    </style>
</resources>
