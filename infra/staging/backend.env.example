# Railway service: baseball_classic
# Copy these into Railway staging variables and replace placeholders with staging-only values.

BASEHAPTIC_ENVIRONMENT=staging
BASEHAPTIC_DATABASE_URL=postgresql+psycopg://postgres.egcsxoxqfcwjjcvjycry:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
BASEHAPTIC_CRAWLER_API_KEY=<staging-crawler-api-key>
BASEHAPTIC_CORS_ALLOW_ORIGINS=*

BASEHAPTIC_DB_POOL_SIZE=1
BASEHAPTIC_DB_MAX_OVERFLOW=0
BASEHAPTIC_DB_POOL_TIMEOUT_SEC=30
BASEHAPTIC_DB_CONNECT_TIMEOUT_SEC=10
BASEHAPTIC_DB_POOL_RECYCLE_SEC=1800

BASEHAPTIC_REDIS_URL=${{Redis-GGli.REDIS_URL}}
BASEHAPTIC_REDIS_PUBSUB_CHANNEL=basehaptic:staging:live_events

BASEHAPTIC_SUPABASE_URL=https://egcsxoxqfcwjjcvjycry.supabase.co
BASEHAPTIC_SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

BASEHAPTIC_APNS_USE_SANDBOX=true
BASEHAPTIC_APNS_BUNDLE_ID=com.basehaptic.app
